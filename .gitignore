# Dependencies
node_modules
.pnpm-store

# Build
.next
dist
.turbo
out
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local
.env.cloudflare
.env.ct
.dev.vars

# Credentials (OAuth, API keys, etc. - never commit)
client_secret*.json
*_secret*.json

# IDE
.idea
.vscode
*.swp

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
pnpm-debug.log*

# Drizzle
# Migrations ARE tracked - they are the schema history and the only way a
# fresh environment can build the database. Previously ignored, which left
# them existing on one machine only.

# Vercel
.vercel

# User uploads (keep folder structure)
apps/web/public/uploads/products/**
!apps/web/public/uploads/products/.gitkeep
apps/web/public/uploads/payment-proofs/**
!apps/web/public/uploads/payment-proofs/.gitkeep
apps/web/public/uploads/reviews/**

# Private KYC uploads (local dev)
apps/admin/.data/

# Reference material and imports - kept on disk, never tracked.
# These held zips over GitHub's 100MB hard limit and blocked every push.
reference/
v0-import/

# OpenNext / wrangler build output
.open-next/
.wrangler/
.transfer/

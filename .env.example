# ─── Database (Neon recommended for production) ───────────────────────────────

#

# Neon ↔ Vercel integration (auto-injected):

#   DATABASE_URL            → pooled  (app runtime)

#   DATABASE_URL_UNPOOLED   → direct  (migrations)

#

# Manual local .env:

#   DATABASE_URL            → direct

#   DATABASE_URL_POOLED     → pooled

#

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require



# ─── Auth ─────────────────────────────────────────────────────────────────────

# Random string, at least 32 characters (required in production)

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional (Phase 21): separate key for 2FA authenticator secrets + backup-code hashes (32+ chars).
# Defaults to a key derived from AUTH_SECRET. Changing either one invalidates every saved authenticator.
# TOTP_ENCRYPTION_KEY=
# Cookie Secure flag. Default: on in production. Set false for LAN HTTP (e.g. http://192.168.x.x).
# AUTH_COOKIE_SECURE=false

# Vercel Cron + manual cron hits (admin project only)

CRON_SECRET=change-me-to-another-long-random-string
# Payouts are simulated until a disbursement provider is wired in. Keep false.
WALLET_PAYOUTS_ENABLED=false
# Unpaid online/manual orders are cancelled (stock released) after this many hours.
ORDER_UNPAID_EXPIRY_HOURS=24
# Signs seller "Preview" links for draft storefronts (admin and web must share it).
# Falls back to AUTH_SECRET; set it on the web app too or previews show the live shop.
# Paid plan upgrades (PayMongo + BIR registration). Keep false until both are done.
NEXT_PUBLIC_PLAN_BILLING_ENABLED=false
# Signs the "Stop reminders" link in reminder SMS (/stop/<token>). Falls back to
# STOREFRONT_PREVIEW_SECRET / AUTH_SECRET; needed on web and wherever SMS are sent.
SMS_OPT_OUT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
STOREFRONT_PREVIEW_SECRET=change-me-to-a-long-random-string-at-least-32-chars



# ─── Google OAuth (seller signup / login) ─────────────────────────────────────

# Create credentials: https://console.cloud.google.com/apis/credentials

# Authorized redirect URIs (add both):

#   http://localhost:3001/api/auth/google/callback

#   https://YOUR-ADMIN-DOMAIN/api/auth/google/callback

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=



# ─── App URLs (set production domains on Vercel) ──────────────────────────────

NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3010

NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

NEXT_PUBLIC_ROOT_DOMAIN=kart.guma.one



# ─── AI (at least one key for live agents; free tier uses Gemini) ─────────────
# Ops Template Intel → Generate with AI uses the thrifty model (Gemini Flash).
# Without a key, ops still gets deterministic high-contrast draft skins (fallback).

OPENAI_API_KEY=

GEMINI_API_KEY=

# GOOGLE_AI_API_KEY=   # alias for Gemini

GROQ_API_KEY=



# ─── Payments mode (MVP / beta) ───────────────────────────────────────────────
# manual_ewallet (default) | paymongo | both
# Direct GCash/Maya/bank until PayMongo API is secured.
PAYMENTS_MODE=manual_ewallet
# Soft launch (Proxmox / testing): free post-publish template switching for sellers.
# Leave unset (or false) for hard production — then template switch requires Pro+.
# Ops can also Force on/off these from Platform → Settings (DB overrides env when set).
# GUMA_SOFT_LAUNCH=true
# Force free switch even in production: GUMA_FREE_TEMPLATE_SWITCH=true
# Force upgrade gate even during soft launch: GUMA_TEMPLATE_SWITCH_REQUIRES_UPGRADE=true

# Development: mocks allowed by default when credentials are missing (labeled).
# Set to "false" to force fail-closed locally (same as production).
# Production (VERCEL_ENV=production): mocks are NEVER allowed, even if true.
# GUMA_ALLOW_INTEGRATION_MOCKS=

# ─── SMS reminders (Growth+ plans; optional for pre-beta) ────────────────────
# Without this key: development returns labeled mock SMS; production returns success:false (not sent).
SEMAPHORE_API_KEY=

# ─── Payments ────────────────────────────────────────────────────────────────
# Required for online checkout in production. Placeholder sk_test_xxx is treated as missing.
# Without a real key: development may return labeled mock intents; production fails checkout (503).
PAYMONGO_SECRET_KEY=
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
# Required for the PayMongo webhook — events are rejected when this is unset.
# Register {WEB}/api/webhooks/paymongo for: checkout_session.payment.paid,
# payment.paid, payment.failed. The secret is shown when you create it.
PAYMONGO_WEBHOOK_SECRET=

# ─── Delivery (Lalamove + GrabExpress) ───────────────────────────────────────
# Without keys: development may return labeled mock quotes; production quote/book fails.
# Checkout may still use seller flat-rate fallback when live courier quote fails.
# Webhooks: {STOREFRONT_URL}/api/webhooks/lalamove and .../grab
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
# "sandbox" or "production"
LALAMOVE_ENV=sandbox
LALAMOVE_WEBHOOK_SECRET=
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_ENV=sandbox
GRAB_WEBHOOK_SECRET=
# ─── BayanGo (in-house courier, Partner API v1) ──────────────────────────────
# Contract: docs/BAYANGO-PARTNER-API-CONTRACT.md. Off until BAYANGO_ENABLED=true.
# Webhook: {STOREFRONT_URL}/api/webhooks/bayango (rejects everything without a secret).
# Dev without URL/key: labeled mock quotes/bookings. Production: never mocked.
BAYANGO_ENABLED=false
BAYANGO_API_BASE_URL=
BAYANGO_API_KEY=
BAYANGO_WEBHOOK_SECRET=
# true = BayanGo wins whenever it can service the route
BAYANGO_PREFERRED=false



# ─── Storefront demo shop ─────────────────────────────────────────────────────

# The /demo and /haloqueen demo shops are only served in development unless
# this is explicitly set to "true".

NEXT_PUBLIC_ENABLE_DEMO_SHOP=

# ── Phase 3/4 platform services (all optional; features degrade gracefully) ──
# Upstash Redis — cross-instance rate limiting (falls back to per-instance memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob — object storage for product images (falls back to local disk in dev)
BLOB_READ_WRITE_TOKEN=
# remove.bg — serverless background removal (local ONNX model used in dev without it)
REMOVE_BG_API_KEY=
# Sentry (or compatible) error tracking — set on web, admin, AND platform Vercel projects.
# createLogger().error / captureError in @gumakart/services forward exceptions when set.
SENTRY_DSN=
# Lalamove webhook signing secret (defaults to LALAMOVE_API_SECRET when unset)
LALAMOVE_WEBHOOK_SECRET=
# After `pnpm --filter @gumakart/services lalamove:check`, pin the layout the logs
# report (json | raw | json-slash | raw-slash). Empty = accept any of them.
LALAMOVE_WEBHOOK_VARIANT=
# Only if a proxy rewrites the path Lalamove calls (default: the request path).
LALAMOVE_WEBHOOK_PATH=
# Web Push (VAPID) — seller push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@guma.one

# ─── Transactional email (Resend) — helpdesk notifications ────────────────────
# Without RESEND_API_KEY: development may log labeled mocks (sent=false, mock=true);
# production never claims a send. Ticket create/reply still succeed.
RESEND_API_KEY=
EMAIL_FROM=Guma Kart <onboarding@resend.dev>
# Inbox that receives new ticket alerts (platform agents)
HELPDESK_NOTIFY_EMAIL=
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3002


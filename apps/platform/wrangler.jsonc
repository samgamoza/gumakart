{
  // Guma Kart ops console (apps/platform) on Cloudflare Workers via OpenNext.
  // Deploy with scripts/deploy-cloudflare.ps1 from the repo root.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gumakart-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Security G4 (GK-24): no *.workers.dev or preview URL — only the custom domain, behind the zone's WAF and rate rules.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ops.guma.one", "custom_domain": true }],
  // Cloudflare Hyperdrive "gumakart-db" -> Neon production (direct). getDb() uses it on Workers.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "93f8b5636eb1478c9f3d13b3e7d589b8" }],
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_STOREFRONT_URL": "https://kart.guma.one",
    "NEXT_PUBLIC_ADMIN_URL": "https://admin.guma.one",
    "NEXT_PUBLIC_PLATFORM_URL": "https://ops.guma.one",
    "NEXT_PUBLIC_ROOT_DOMAIN": "guma.one"
  }
}

# ─── gpu-bridge (AI Marketing Suite) ───────────────────────────────────────────
# Postgres — same database as kart.guma.one (Neon direct or pooled URL).
DATABASE_URL=
# Redis for BullMQ (TCP). Local Redis on the workstation, or Upstash's rediss:// TCP URL.
REDIS_URL=redis://127.0.0.1:6379

# Local GPU node (Cloudflare Tunnel hostnames, or http://127.0.0.1:… when running on the workstation)
LLM_BASE_URL=https://llm-node.guma.one/v1
LLM_API_KEY=
LLM_MODEL=qwen3-235b
COMFY_BASE_URL=https://gpu-node.guma.one
# Cloudflare Access service token, if the tunnel hostnames are behind Access (recommended).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
GPU_NODE_ID=home-gpu-1

# Rendered media: s3 = Cloudflare R2 / MinIO; local = folder (dev only)
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=guma-ai-media
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=https://media.guma.one

# Tuning (defaults shown)
# REALTIME_CONCURRENCY=8
# REALTIME_TIMEOUT_MS=45000
# BATCH_CONCURRENCY=1
# BATCH_MAX_ATTEMPTS=3
# COMFY_POLL_INTERVAL_MS=2000
# COMFY_JOB_TIMEOUT_MS=1200000
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_MS=30000
# OFFLINE_HOLD_MS=60000
# DISPATCH_INTERVAL_MS=3000
# HEALTH_INTERVAL_MS=15000
# STUCK_JOB_MS=2700000
# ENABLE_REALTIME=true
# ENABLE_BATCH=true

# ─── Phase 2: realtime HTTP endpoint (published by cloudflared as https://bridge.guma.one) ───
ENABLE_HTTP=true
BRIDGE_HTTP_HOST=127.0.0.1
BRIDGE_HTTP_PORT=8790
# Same value as GPU_BRIDGE_SECRET in the admin app. Generate: openssl rand -hex 32
GPU_BRIDGE_SECRET=
# HTTP_REALTIME_WAIT_MS=30000

# ─── Phase 2: media pipelines ───
MEDIA_SOURCE_HOSTS=kart.guma.one,media.guma.one,*.public.blob.vercel-storage.com
MEDIA_SOURCE_BASE_URL=https://kart.guma.one
WORK_DIR=./.work
LLM_VISION_MODEL=qwen3-vl
FFMPEG_PATH=ffmpeg
FFMPEG_ENCODER=auto
VOICE_PRESETS_DIR=./voices
BGM_DIR=
SUBTITLE_FONT=Montserrat ExtraBold
# Model file names as installed in ComfyUI (defaults shown)
# FLUX_FILL_UNET=flux1-fill-dev.safetensors
# FLUX_CLIP_L=clip_l.safetensors
# FLUX_T5=t5xxl_fp8_e4m3fn.safetensors
# FLUX_VAE=ae.safetensors
# RMBG_MODEL=RMBG-2.0
# WAN_I2V_UNET=wan2.1_i2v_480p_14B_fp8_e4m3fn.safetensors
# WAN_TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors
# WAN_VAE=wan_2.1_vae.safetensors
# WAN_CLIP_VISION=clip_vision_h.safetensors
# COMFY_NODE_RMBG=RMBG
# COMFY_NODE_F5TTS=F5TTSAudioInputs
